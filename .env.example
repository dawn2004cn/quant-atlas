# ==========================================
#  SECURITY WARNING: This file contains placeholder values.
#  Copy to .env and fill in your real credentials.
#  NEVER commit .env to version control.
# ==========================================

# ==========================================
# 1. 核心运行环境 (重要)
# ==========================================
FLASK_APP=run.py
FLASK_DEBUG=0
FLASK_SECRET_KEY=changeme
PYTHONPATH=.

# ==========================================
# 日志（生产环境用 LOG_LEVEL 调节输出量）
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
# LOG_SQL=1 时输出 SQL 追踪与 sqlalchemy.engine 语句
# 敏感信息仍放 config/secret.cfg，勿写入 .env
# ==========================================
LOG_LEVEL=INFO
LOG_SQL=0
LOG_SQL_LEVEL=INFO
LOG_FILE=instance/app.log
LOG_STRUCTURED=0
LOG_COLORS=1
LOG_WERKZEUG_LEVEL=WARNING

# ==========================================
# 核心数据库切换开关
# ==========================================
DATABASE_BACKEND=mysql

# ==========================================
# 主数据库配置 (Master / 写库)
# 用于：用户登录、自选股修改、行情写入、任务提交等
# ==========================================
MYSQL_HOST=192.168.1.1
MYSQL_PORT=3307
MYSQL_USER=changeme
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=quant_atlas

# ==========================================
# 从数据库配置 (Slave / 读库)
# 用于：仪表盘展示、历史数据查询、报表生成等
# ==========================================
# 如果 MYSQL_READ_HOST 留空，系统将自动使用上面的主库配置
MYSQL_READ_HOST=192.168.1.1
MYSQL_READ_PORT=3307
MYSQL_READ_USER=changeme
MYSQL_READ_PASSWORD=changeme
MYSQL_READ_DATABASE=quant_atlas

# ==========================================
# TimescaleDB / PostgreSQL（时序行情，可与 MySQL 并存）
# USE_TIMESCALEDB=1 时启用；DATABASE_BACKEND=timescaledb 则主库切到 PG
# ==========================================
USE_TIMESCALEDB=1
TIMESCALEDB_HOST=192.168.1.1
TIMESCALEDB_PORT=5434
TIMESCALEDB_USER=changeme
TIMESCALEDB_PASSWORD=changeme
TIMESCALEDB_DATABASE=quant_atlas
TDX_SYNC_ENABLE_TIMESCALE=0
ENABLE_TIMESCALE_TDX_SYNC=1
# 需要 Beat 时打开
TIMESCALE_TDX_SYNC_BEAT=1
TIMESERIES_INCREMENTAL_OVERLAP_DAYS=5
TDX_SYNC_INCREMENTAL_OVERLAP_DAYS=5
# 兼容旧变量名
POSTGRES_HOST=192.168.1.1
POSTGRES_PORT=5434
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DATABASE=quant_atlas

# ==========================================
# QUESTDB / CLICKHOUSE（时序行情，可与 MySQL 并存）
# ENABLE_QUESTDB=1 时启用；DATABASE_BACKEND=timescaledb 则主库切到 PG
# ENABLE_CLICKHOUSE=1时启用
# ==========================================
ENABLE_QUESTDB=1
QUESTDB_HOST=192.168.1.1
# 8813=PostgreSQL 线协议（SQL/探活/写入默认）；8812=HTTP /exec（可选）
QUESTDB_PG_PORT=8813
QUESTDB_HTTP_PORT=8812
QUESTDB_USE_PG_WIRE=1
QUESTDB_ILP_PORT=9010
QUESTDB_USER=changeme
QUESTDB_PASSWORD=changeme
QUESTDB_DATABASE=qdb
QUESTDB_OHLCV_TABLE=stock_history

# 若 ClickHouse 也有同结构表再启用：
ENABLE_CLICKHOUSE=1
CLICKHOUSE_HOST=192.168.1.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=changeme
CLICKHOUSE_PASSWORD=changeme
CLICKHOUSE_DATABASE=default
CLICKHOUSE_OHLCV_TABLE=stock_history

# 时序同步（TDX→QuestDB/CH，Beat 全市场增量）
ENABLE_TIMESERIES_SYNC=1
ENABLE_QUESTDB_SYNC=1
QUESTDB_SYNC_BEAT=1
TIMESERIES_SYNC_INCREMENTAL=1
TIMESERIES_SYNC_ALL_MARKET=1
TIMESERIES_SYNC_LIMIT=0
TIMESERIES_SYNC_MAX_SYMBOLS=50000
TIMESERIES_UPSERT_DELETE_RANGE=1
TIMESERIES_INCREMENTAL_OVERLAP_DAYS=5
TDX_SYNC_INCREMENTAL_OVERLAP_DAYS=5
HISTORY_PREFER_TIMESERIES=1
TIMESCALE_SYNC_LIMIT=0

# 收盘一键链 TDX→MySQL→qlib（需 TDX_DAYK_CELERY_BEAT=1）
TDX_DAYK_CELERY_BEAT=0
TDX_USE_SCHEDULED_DAILY_CHAIN=1

# ==========================================
# 3. 异步任务与扫描器剥离 (核心)
# ==========================================
ENABLE_CELERY=1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# 2. 剥离关键：禁用 Web 进程内的本地扫描线程
# 设为 0 (或留空) 以后，Web 进程将不再启动 Scanner 线程，而是依赖 Celery Worker
SCANNER_FORCE_THREADS=0

# 3. 调度关键：开启 Celery Beat 中的扫描定时任务
# 开启后，Beat 会定时向 Worker 发送扫描指令
SCANNER_CELERY_BEAT=1

# 4. (推荐) 禁用 Web 进程内的数据调度器
# 既然用了 Celery，龙虎榜/研报等定时数据抓取也应该由 Celery 处理
ENABLE_BASIC_DATA_SCHEDULER=0

# ==========================================
# 12. OpenBB/FMP API Key (全球行情)
# ==========================================
FMP_API_KEY=your_key_here
TUSHARE_TOKEN=your_token_here
TAVILY_API_KEY=your_key_here
# ==========================================
# 5. AI / LLM 与 Agent 配置 (核心)
# ==========================================
# LLM 统一配置（所有 Agent 共用）
# openai, deepseek, ollama, custom  （根据实际使用的模型提供商选择）
LLM_PROVIDER=ollama
#LLM_PROVIDER=openrouter
# 模型名称  （根据 LLM_PROVIDER 选择对应的模型，如 openai 可选 gpt-4o-mini、gpt-3.5-turbo 等）
#LLM_MODEL=gpt-4o-mini
#minimax/minimax-m2.5:free
LLM_MODEL=llama3.2:3b
# 访问密钥（如果使用远程 API，必须提供；如果使用本地模型，可以留空或设置为任意值）
#LLM_API_KEY=your_key_here
LLM_API_KEY=your_key_here
# 访问端点（如果使用远程 API，必须提供；如果使用本地模型，可以设置为本地服务地址）
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_TIMEOUT=120

# 兼容旧配置（可选，逐步迁移）
# OPENAI_API_KEY=$LLM_API_KEY
# RDAGENT_MODEL=deepseek-coder-v2:16b
# RDAGENT_BASE_URL=http://localhost:11434/v1

# RD-Agent 核心开关
ENABLE_RD_AGENT=1
ENABLE_QLIB=1

# ==========================================
# 6. 其他第三方集成
# ==========================================
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=

# ==========================================
# 7.  RD-Agent & LLM 增强配置
# ==========================================
# 开启本地模型支持
RDAGENT_MODEL=deepseek-coder-v2:16b
# 对应 Ollama 或本地 vLLM 端点
RDAGENT_BASE_URL=http://localhost:11434/v1
# 本地模型通常不需要 Key
RDAGENT_API_KEY=your_key_here
#建议用 llama3.1:8b 或 qwen3:8b（支持推理）
LANGCHAIN_PROVIDER=ollama
# 小模型，内存友好
LANGCHAIN_MODEL_NAME=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# 或者使用远程 DeepSeek 官方 API (高性价比)
# RDAGENT_MODEL=deepseek-coder
# RDAGENT_BASE_URL=https://api.deepseek.com
# RDAGENT_API_KEY=sk-xxxx

# ==========================================
# 8. 通达信数据配置
# ==========================================
TDX_ROOT_PATH=C:\tdx\

# ==========================================
# 8.1 回测数据复权（AkShare）
# hfq=后复权（默认，减少前视偏差）| qfq=前复权 | none=不复权
# ==========================================
AKSHARE_BACKTEST_ADJUST=hfq

# ==========================================
# 9. 同花顺登陆配置
# ==========================================
THS_USERNAME=your_username_here
THS_PASSWORD=changeme

# ==========================================
# 9.1 QMT 执行网关（默认 simulation，禁止误触实盘）
# QMT_ACCOUNT_ID / QMT_PATH 配置后 gateway 为 simulation；仅 QMT_LIVE_SUBMIT=1 才走 xtquant
# ==========================================
QMT_ACCOUNT_ID=
QMT_PATH=
QMT_LIVE_SUBMIT=0
EXECUTION_DEFAULT_MODE=paper

# QuestDB 日K Celery Beat（收盘后 16:35 增量同步，需 ENABLE_CELERY=1 + Beat 进程）
QUESTDB_SYNC_BEAT=1

# ==========================================
# 10. 集群mesh 配置
# ==========================================
TASK_MESSAGE_REDIS_URL=redis://127.0.0.1:6379/0
MESH_ENABLED=1
MESH_NODE_ID=changeme
MESH_REGION=CN
MESH_TRANSPORT=redis
EVENT_BUS_CLUSTER_MODE=auto

# ==========================================
# 11 启用联邦集群定时扫描
# ==========================================
FEDERATED_CLUSTER_BEAT=1
FEDERATED_CLUSTER_BEAT_MINUTES=5
