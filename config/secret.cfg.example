# JWT RS256 key configuration (optional, defaults to HS256 with API_JWT_SECRET)
# Generate keys with: python scripts/generate_jwt_keys.py
#
# Option 1: File paths (recommended for production)
JWT_PRIVATE_KEY_PATH=instance/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=instance/keys/jwt-public.pem
API_JWT_ALG=RS256
#
# Option 2: Base64-encoded PEM in environment variables
# API_JWT_RSA_PRIVATE_KEY=<base64 of jwt-private.pem>
# API_JWT_RSA_PUBLIC_KEYS=<base64 of jwt-public.pem>
#
# Option 3: HS256 symmetric key (simpler, but less secure for multi-service)
# API_JWT_SECRET=<at least 32 characters>
# API_JWT_ALG=HS256
#
# Token TTL
# API_JWT_TTL_SECONDS=3600